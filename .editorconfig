root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Desktop form replies pinned byte for byte: no final newline, trailing spaces kept.
[examples/data/form-replies/*.txt]
insert_final_newline = false
trim_trailing_whitespace = false
