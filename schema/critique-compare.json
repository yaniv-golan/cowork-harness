{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "critique-compare.json",
  "title": "cowork-harness critique --compare payload",
  "description": "EXPERIMENTAL, descriptive: the payload of `critique --compare --output-format json`, inside the standard envelope ({tool, version, command, ok, ...}). Several critiques of one skill side by side, with NO verdict. Carries finding text (publicSafe is always false).",
  "type": "object",
  "properties": {
    "mode": { "const": "compare" },
    "publicSafe": { "const": false },
    "note": { "type": "string" },
    "noiseFloorControl": { "type": "boolean", "description": "two groups with the same (non-null) corpusHash and the same single skillTreeHash: any difference is run-to-run variation" },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": { "type": ["string", "null"] },
          "N": { "type": "integer" },
          "reports": { "type": "array", "items": { "type": "object" } },
          "corpusHash": { "type": ["string", "null"] },
          "skillTreeHashes": { "type": "array", "items": { "type": "string" }, "description": "the distinct skillTreeHash values in the group" },
          "marks": { "type": "array", "description": "--strict refuses mixedEvaluator, mixedBasis, mixedSkillTree, mixedProbe and pass1Only; mixedPackagedCorpus and probeUnverified are only marked", "items": { "enum": ["mixedEvaluator", "mixedBasis", "mixedSkillTree", "mixedPackagedCorpus", "mixedProbe", "probeUnverified", "pass1Only"] } },
          "byClassification": { "type": "object", "description": "classification -> every finding of that classification, per report" },
          "sameWording": {
            "type": "array",
            "description": "an exact findingFingerprint in k of N reports — a LOWER bound",
            "items": {
              "type": "object",
              "properties": { "findingFingerprint": { "type": "string" }, "classification": { "type": "string" }, "k": { "type": "integer" }, "N": { "type": "integer" } },
              "required": ["findingFingerprint", "classification", "k", "N"]
            }
          },
          "sharedExcerpt": {
            "type": "array",
            "description": "the same cited passage under the same classification in k of N reports — a cue to read them together, not a match",
            "items": {
              "type": "object",
              "properties": {
                "anchor": { "type": "string" },
                "k": { "type": "integer" },
                "N": { "type": "integer" },
                "distinctIdeas": { "type": "integer" },
                "distinctActions": { "type": "integer" }
              },
              "required": ["anchor", "k", "N", "distinctIdeas", "distinctActions"]
            }
          }
        },
        "required": ["label", "N", "reports", "corpusHash", "skillTreeHashes", "marks", "byClassification", "sameWording", "sharedExcerpt"],
        "additionalProperties": false
      }
    },
    "fingerprints": {
      "type": "array",
      "description": "every exact findingFingerprint with its k/N in each group",
      "items": {
        "type": "object",
        "properties": {
          "findingFingerprint": { "type": "string" },
          "classification": { "type": "string" },
          "groups": { "type": "array", "items": { "type": "object", "properties": { "k": { "type": "integer" }, "N": { "type": "integer" } }, "required": ["k", "N"] } }
        },
        "required": ["findingFingerprint", "classification", "groups"]
      }
    },
    "possibleRewordings": {
      "type": "object",
      "properties": { "basis": { "type": "string" }, "pairs": { "type": "array", "items": { "type": "object" } } },
      "required": ["basis", "pairs"]
    },
    "excluded": {
      "type": "array",
      "items": { "type": "object", "properties": { "file": { "type": "string" }, "reason": { "type": "string" } }, "required": ["file", "reason"] }
    },
    "clustering": {
      "type": "object",
      "description": "--cluster: none (default) or lexical. Built over citation-resolved findings only. Nothing is sent anywhere. `validated` is null: no labelled set has validated a grouping, so no output says a finding was reproduced.",
      "properties": {
        "mode": { "enum": ["none", "lexical"] },
        "population": { "const": "citation-resolved" },
        "similarity": {
          "type": "object",
          "properties": {
            "scheme": { "const": "char_wb-3-5-tfidf/1" },
            "text": { "type": "string" },
            "idf": { "type": "string" },
            "linkage": { "const": "complete" },
            "threshold": { "type": "number" }
          },
          "required": ["scheme", "text", "idf", "linkage", "threshold"],
          "additionalProperties": false
        },
        "findingsCompared": { "type": "integer" },
        "summariesSkipped": { "type": "string" },
        "sent": { "const": "nothing" },
        "validated": { "type": "null" }
      },
      "required": ["mode", "population", "sent", "validated"],
      "additionalProperties": false
    },
    "candidateGroups": {
      "type": "array",
      "description": "lexical mode only: findings whose every pair is at or above the similarity threshold (complete linkage), in input order. A group must span at least two reports (one whose members all come from one report is dropped), and a finding with neither idea nor recommendedAction text takes no part. A JUDGEMENT from word overlap, not a match: no k/N, and an ungrouped finding is not a claim that no reworded repeat exists.",
      "items": {
        "type": "object",
        "properties": {
          "basis": { "const": "lexical-similarity (a judgement, not a match)" },
          "groups": { "type": "null" },
          "members": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "properties": {
                "labelGroup": { "type": ["string", "null"] },
                "report": { "type": "integer" },
                "sessionId": { "type": ["string", "null"] },
                "itemIndex": { "type": "integer" },
                "findingFingerprint": { "type": "string" },
                "classification": { "type": "string" },
                "idea": { "type": "string" }
              },
              "required": ["labelGroup", "report", "sessionId", "itemIndex", "findingFingerprint", "classification", "idea"],
              "additionalProperties": false
            }
          }
        },
        "required": ["basis", "groups", "members"],
        "additionalProperties": false
      }
    }
  },
  "required": ["mode", "publicSafe", "note", "noiseFloorControl", "groups", "fingerprints", "possibleRewordings", "excluded", "clustering"],
  "additionalProperties": false
}
